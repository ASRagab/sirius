<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The microphone under the hardened runtime, for dictation (as Parrot.entitlements). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Calendar, Reminders, Contacts and Apple Events under the hardened runtime, for the agents' tools; asked for on first use (Info.plist). -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
