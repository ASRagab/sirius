{
  "description": "A toast that replaces the agent's own",
  "frame": {
    "jsonrpc": "2.0",
    "sirius": 1,
    "id": "1",
    "method": "display",
    "params": {
      "kind": "toast",
      "content": "Done.",
      "replace": true
    }
  },
  "expect": {
    "result": "display",
    "id": "1",
    "params": {
      "content": [
        {
          "type": "text",
          "text": "Done."
        }
      ],
      "kind": "toast",
      "replace": true
    }
  }
}
